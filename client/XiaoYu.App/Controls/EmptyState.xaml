<!-- 空状态：一个大图标加一句话。用法：<c:EmptyState Glyph="{StaticResource IconSearch}" Text="没有找到" /> -->
<UserControl x:Class="XiaoYu.App.Controls.EmptyState"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:s="clr-namespace:XiaoYu.App.Services"
             s:Motion.Appear="True">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,56">
        <Border Width="88" Height="88" CornerRadius="44" Background="#EFEFEB" HorizontalAlignment="Center">
            <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="34" Foreground="#C9C9C4" />
        </Border>
        <TextBlock x:Name="LabelText" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center" Margin="0,16,0,0" />
    </StackPanel>
</UserControl>
