<!--
  商品卡片，DataContext 是一个 GoodsBrief。点一下打开商品详情。悬停时轻轻上浮、出现阴影。
  用法：<ItemsControl ItemsSource="{Binding Goods}"> 里放 CardGrid（按宽度自动排列数），ItemTemplate 里放 <c:GoodsCard />
  卡片宽度由 CardGrid 决定，封面始终接近正方形
-->
<UserControl x:Class="XiaoYu.App.Controls.GoodsCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services"
             Cursor="Hand" SizeChanged="OnSizeChanged" s:Motion.Appear="True">
    <Border x:Name="CardBorder" Background="White" CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5" MouseLeftButtonUp="OnClick">
        <Border.RenderTransform><TranslateTransform x:Name="Lift" /></Border.RenderTransform>
        <Border.Effect><DropShadowEffect x:Name="Shadow" BlurRadius="24" ShadowDepth="6" Direction="270" Opacity="0" Color="#000000" /></Border.Effect>
        <Border.Triggers>
            <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="-4" Duration="0:0:0.16" />
                    <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.16" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
            <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard><Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2" />
                    <DoubleAnimation Storyboard.TargetName="Shadow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2" />
                </Storyboard></BeginStoryboard>
            </EventTrigger>
        </Border.Triggers>
        <StackPanel>
            <Grid x:Name="Cover" Height="212" Background="#F0F0EC">
                <Grid.Clip><RectangleGeometry x:Name="CoverClip" Rect="0,0,214,260" RadiusX="17" RadiusY="17" /></Grid.Clip>
                <Image s:RemoteImage.Source="{Binding Cover}" Stretch="UniformToFill" />
                <!-- 不是"在售"时，左上角显示状态 -->
                <Border Background="#B3000000" CornerRadius="10" Padding="9,3" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="on_sale"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Status, Converter={StaticResource GoodsStatusText}}" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                </Border>
            </Grid>
            <StackPanel Margin="14,11,14,13">
                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"
                           MaxHeight="40" LineHeight="20" LineStackingStrategy="BlockLineHeight" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource PriceBrush}" FontWeight="Bold">
                    <Run Text="¥" FontSize="13" /><Run Text="{Binding Price, Mode=OneWay, Converter={StaticResource Yuan}}" FontSize="21" />
                </TextBlock>
                <DockPanel Margin="0,10,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconEye}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                        <TextBlock Text="{Binding ViewCount}" Style="{StaticResource Hint}" Margin="4,0,0,0" Foreground="{StaticResource TertiaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <c:Avatar Image="{Binding Seller.Avatar}" Nickname="{Binding Seller.Nickname}" Size="20" />
                        <TextBlock Text="{Binding Seller.Nickname}" Style="{StaticResource Hint}" Margin="6,0,0,0" MaxWidth="90"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
