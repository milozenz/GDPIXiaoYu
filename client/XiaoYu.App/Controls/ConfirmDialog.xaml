<!-- 自绘的确认/提示对话框：圆角白卡片 + 图标 + 一句话 + 按钮。Ui.Confirm / Ui.Info / Ui.Error 用它。 -->
<Window x:Class="XiaoYu.App.Controls.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="28">
        <Border x:Name="Card" Background="White" CornerRadius="22" Padding="30,28,30,24" MinWidth="320" MaxWidth="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <Border x:Name="IconBox" Width="52" Height="52" CornerRadius="26" Background="{StaticResource PrimarySoft}" HorizontalAlignment="Center">
                    <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="24" />
                </Border>
                <TextBlock x:Name="TitleText" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                <TextBlock x:Name="MessageText" Style="{StaticResource Body}" Foreground="{StaticResource SecondaryTextBrush}"
                           TextAlignment="Center" Margin="0,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                    <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="110" Margin="0,0,12,0" Click="OnCancel" IsCancel="True" />
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定" MinWidth="110" Click="OnOk" IsDefault="True" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
