<!-- 忘记密码：和登录、注册同一套风格。 -->
<Window x:Class="XiaoYu.App.Shell.ResetPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:XiaoYu.App.Services"
        Icon="pack://application:,,,/XiaoYu;component/app.ico"
        Title="找回密码" Width="440" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
    <Grid ClipToBounds="True">
        <Ellipse Width="300" Height="300" Fill="{StaticResource Primary}" Opacity="0.95" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-130,0" />
        <StackPanel VerticalAlignment="Center" Margin="48,10,48,10" s:Motion.Appear="True">
            <Border Width="64" Height="64" CornerRadius="22" Background="{StaticResource Primary}" HorizontalAlignment="Center" BorderBrush="White" BorderThickness="2.5">
                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="26" Foreground="{StaticResource TextBrush}" />
            </Border>
            <TextBlock Text="找回密码" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,16,0,8" />
            <TextBlock Text="用注册时的邮箱收验证码，然后设置新密码" Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,0,0,22" />

            <Border Style="{StaticResource Field}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconMail}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBox x:Name="EmailBox" Style="{StaticResource BareInput}" Tag="注册时用的邮箱" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                </DockPanel>
            </Border>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="50" MinWidth="118" Margin="10,0,0,0" Padding="14,0"
                        Content="{Binding CodeButtonText}" Command="{Binding SendCodeCommand}" IsEnabled="{Binding CanSendCode}" />
                <Border Style="{StaticResource Field}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                        <TextBox Style="{StaticResource BareInput}" Tag="6 位验证码" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                    </DockPanel>
                </Border>
            </DockPanel>
            <TextBlock Text="{Binding CodeHint}" Style="{StaticResource Hint}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="4,8,0,0"
                       Visibility="{Binding CodeHint, Converter={StaticResource NotEmptyToVis}}" />
            <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource BarePassword}" PasswordChanged="OnPasswordChanged" MaxLength="32" />
                </DockPanel>
            </Border>
            <TextBlock Text="新密码：8–32 位，同时包含数字、大写字母和小写字母" Style="{StaticResource Hint}" Margin="4,6,0,0" />
            <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource BarePassword}" PasswordChanged="OnConfirmChanged" MaxLength="32" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,12,0,0" />
            <Button Style="{StaticResource PrimaryButton}" Height="50" Margin="0,20,0,0" IsDefault="True" Command="{Binding ResetCommand}">
                <TextBlock Text="重置密码" FontSize="16" FontWeight="Bold" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
