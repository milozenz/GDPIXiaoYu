<!-- 登录窗口：一个会轻轻浮动的 logo、两个输入框、一个大按钮。少文字。 -->
<Window x:Class="XiaoYu.App.Shell.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:XiaoYu.App.Services"
        Icon="pack://application:,,,/XiaoYu;component/app.ico"
        Title="广理职小鱼" Width="440" Height="660"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
    <Grid ClipToBounds="True">
        <!-- 背景装饰：两个柔和的圆 -->
        <Ellipse Width="380" Height="380" Fill="{StaticResource Primary}" Opacity="0.95" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-190,-160,0" />
        <Ellipse Width="220" Height="220" Fill="{StaticResource PrimaryLight}" Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-90,0,0,-70" />

        <StackPanel VerticalAlignment="Center" Margin="48,0,48,10" s:Motion.Appear="True">
            <Border Width="104" Height="104" HorizontalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="7" Direction="270" Opacity="0.22" Color="#C99A00" /></Border.Effect>
                <Border.RenderTransform><TranslateTransform x:Name="Float" /></Border.RenderTransform>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard><Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetName="Float" Storyboard.TargetProperty="Y" From="0" To="-7" Duration="0:0:1.6">
                                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard></BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Image Source="{StaticResource LogoImage}" />
            </Border>
            <TextBlock Text="广理职小鱼" Style="{StaticResource H1}" FontSize="26" HorizontalAlignment="Center" Margin="0,22,0,34" />

            <Border Style="{StaticResource Field}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconUser}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource BareInput}" Tag="用户名或邮箱" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Field}" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource BarePassword}" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,12,0,0" />

            <Button Style="{StaticResource PrimaryButton}" Height="50" Margin="0,22,0,0" IsDefault="True"
                    Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=PasswordBox}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="登录" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChevronRight}" FontSize="13" Margin="8,2,0,0" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Button Style="{StaticResource LinkButton}" Content="注册新账号" Click="OnRegisterClick" />
                <TextBlock Text="·" Foreground="{StaticResource TertiaryTextBrush}" Margin="12,0" VerticalAlignment="Center" />
                <Button Style="{StaticResource LinkButton}" Content="忘记密码" Click="OnForgotClick" />
            </StackPanel>
        </StackPanel>

        <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Hint}" Foreground="{StaticResource TertiaryTextBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" />
    </Grid>
</Window>
