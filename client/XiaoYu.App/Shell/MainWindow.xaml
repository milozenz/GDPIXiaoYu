<!-- 主窗口：顶部一排图标导航 + 中间放页面 + 底部浮出的提示 -->
<Window x:Class="XiaoYu.App.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:XiaoYu.App.Controls"
        Icon="pack://application:,,,/XiaoYu;component/app.ico"
        Title="广理职小鱼" Width="1200" Height="800" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部栏 -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Height="68" Padding="22,0">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Command="{Binding BackCommand}" ToolTip="返回" Margin="0,0,10,0"
                            Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconBack}" FontSize="16" />
                    </Button>
                    <Image Source="{StaticResource LogoImage}" Width="42" Height="42" />
                    <TextBlock Text="广理职小鱼" FontWeight="Bold" FontSize="17" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <RadioButton Style="{StaticResource NavTab}" Tag="首页" Command="{Binding GoHomeCommand}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource ValueEquals}, ConverterParameter=home}">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconHome}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" Tag="发布" Command="{Binding GoPublishCommand}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource ValueEquals}, ConverterParameter=publish}">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconAdd}" />
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" Tag="消息" Command="{Binding GoChatCommand}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource ValueEquals}, ConverterParameter=chat}">
                        <Grid>
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChat}" />
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-9,-12,0" BorderBrush="White" BorderThickness="1.5"
                                    Visibility="{Binding UnreadCount, Converter={StaticResource NotEmptyToVis}}">
                                <TextBlock Text="{Binding UnreadCount}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavTab}" Tag="我的" Command="{Binding GoMeCommand}"
                                 IsChecked="{Binding ActiveTab, Converter={StaticResource ValueEquals}, ConverterParameter=me}">
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconUser}" />
                    </RadioButton>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="{StaticResource FieldBrush}" CornerRadius="17" Padding="14,6" ToolTip="余额">
                        <TextBlock FontWeight="Bold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center">
                            <Run Text="¥" FontSize="12" /><Run Text="{Binding Balance, Mode=OneWay, Converter={StaticResource Yuan}}" FontSize="15" />
                        </TextBlock>
                    </Border>
                    <Button Style="{StaticResource IconButton}" Command="{Binding GoMeCommand}" Width="46" Height="46" Margin="10,0,0,0" ToolTip="{Binding Nickname}">
                        <c:Avatar Image="{Binding Avatar}" Nickname="{Binding Nickname}" Size="38" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 断线提示 -->
        <Border Grid.Row="1" Background="#FFF3E0" Padding="8,7" Visibility="{Binding IsConnected, Converter={StaticResource InvBoolToVis}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconRefresh}" FontSize="13" Foreground="#E65100" />
                <TextBlock Text="连接断开，正在重连…" Foreground="#E65100" FontSize="13" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <!-- 页面放在这里，由 Navigator 切换 -->
        <ContentControl Grid.Row="2" x:Name="PageHost" Focusable="False" />

        <!-- 底部浮出的提示 -->
        <Border Grid.Row="2" x:Name="Toast" Background="#F2222222" CornerRadius="16" Padding="18,11" Margin="24,24,24,30"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" MaxWidth="520" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
            <Border.RenderTransform><TranslateTransform x:Name="ToastShift" Y="16" /></Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="13" Foreground="{StaticResource Primary}" Margin="0,0,10,0" />
                <TextBlock x:Name="ToastLabel" Foreground="White" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
