<!-- 商品详情：左边大图和缩略图，右边价格、标题、信息、卖家和操作按钮 -->
<UserControl x:Class="XiaoYu.App.Pages.Trade.GoodsDetailPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services">
    <UserControl.Resources>
        <!-- 心形：收藏后变红实心，并"砰"地弹一下 -->
        <Style x:Key="HeartIcon" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
            <Setter Property="Text" Value="{StaticResource IconHeartOutline}" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="RenderTransform"><Setter.Value><ScaleTransform /></Setter.Value></Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                    <Setter Property="Text" Value="{StaticResource IconHeart}" />
                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleX">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.35" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="RenderTransform.ScaleY">
                                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0.6" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.18" Value="1.35" />
                                <EasingDoubleKeyFrame KeyTime="0:0:0.32" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="1060" Margin="32,26,32,40" HorizontalAlignment="Stretch" Visibility="{Binding Loaded, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" />
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- 左：图片 -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                <Grid Width="540" Height="540" Background="#F0F0EC">
                    <Grid.Clip><RectangleGeometry Rect="0,0,540,540" RadiusX="26" RadiusY="26" /></Grid.Clip>
                    <Image s:RemoteImage.Source="{Binding MainImage}" Stretch="UniformToFill" />
                    <Border Background="#99000000" Visibility="{Binding IsOnSale, Converter={StaticResource InvBoolToVis}}">
                        <TextBlock Text="{Binding Detail.Status, Converter={StaticResource GoodsStatusText}}" Foreground="White" FontSize="34" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>
                <ItemsControl ItemsSource="{Binding Thumbs}" Margin="0,14,0,0" Visibility="{Binding Thumbs.Count, Converter={StaticResource NotEmptyToVis}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,10" Padding="0" Cursor="Hand" Command="{Binding DataContext.SelectImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Width="74" Height="74" CornerRadius="16" BorderThickness="2.5" BorderBrush="Transparent" Background="#F0F0EC">
                                            <Grid Margin="0">
                                                <Grid.Clip><RectangleGeometry Rect="0,0,69,69" RadiusX="13" RadiusY="13" /></Grid.Clip>
                                                <Image s:RemoteImage.Source="{Binding Name}" Stretch="UniformToFill" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- 右：信息 -->
            <StackPanel Grid.Column="2" s:Motion.Appear="True">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="{StaticResource PriceBrush}" FontWeight="Bold" VerticalAlignment="Bottom">
                        <Run Text="¥" FontSize="22" /><Run Text="{Binding Detail.Price, Mode=OneWay, Converter={StaticResource Yuan}}" FontSize="44" />
                    </TextBlock>
                    <TextBlock Foreground="{StaticResource TertiaryTextBrush}" FontSize="15" TextDecorations="Strikethrough" Margin="14,0,0,8" VerticalAlignment="Bottom"
                               Text="{Binding Detail.OriginalPrice, Converter={StaticResource Money}}"
                               Visibility="{Binding Detail.OriginalPrice, Converter={StaticResource NotEmptyToVis}}" />
                </StackPanel>
                <TextBlock Text="{Binding Detail.Title}" Style="{StaticResource H1}" FontSize="22" TextWrapping="Wrap" LineHeight="32" Margin="0,10,0,0" />

                <WrapPanel Margin="0,16,0,0">
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,8" Background="{StaticResource PrimarySoft}">
                        <TextBlock Text="{Binding Detail.Condition, Converter={StaticResource ConditionText}}" FontSize="12" Foreground="#8A6D00" FontWeight="SemiBold" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,8">
                        <TextBlock Text="{Binding Detail.CategoryName}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconEye}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Detail.ViewCount}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Badge}" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconClock}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock Text="{Binding Detail.CreatedAt, Converter={StaticResource TimeAgo}}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="5,0,0,0" />
                        </StackPanel>
                    </Border>
                </WrapPanel>

                <TextBlock Text="{Binding Detail.Description}" Foreground="#5E5E5A" FontSize="14.5" TextWrapping="Wrap" LineHeight="25" Margin="0,8,0,0"
                           Visibility="{Binding Detail.Description, Converter={StaticResource NotEmptyToVis}}" />

                <!-- 卖家 -->
                <Button Style="{StaticResource RowButton}" Command="{Binding OpenSellerCommand}" Margin="0,24,0,0">
                    <Border Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="16,14">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{StaticResource IconChevronRight}" FontSize="13" Foreground="{StaticResource TertiaryTextBrush}" />
                            <c:Avatar DockPanel.Dock="Left" Image="{Binding Detail.Seller.Avatar}" Nickname="{Binding Detail.Seller.Nickname}" Size="44" />
                            <TextBlock Text="{Binding Detail.Seller.Nickname}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" Margin="14,0,0,0" />
                        </DockPanel>
                    </Border>
                </Button>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,16,0,0" />

                <!-- 别人的商品：收藏 / 聊一聊 / 立即购买 -->
                <StackPanel Margin="0,22,0,0" Visibility="{Binding IsMine, Converter={StaticResource InvBoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="52" Height="52" Margin="0,0,10,0" Command="{Binding ToggleFavoriteCommand}" ToolTip="收藏">
                            <TextBlock Style="{StaticResource HeartIcon}" />
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource SecondaryButton}" Height="52" Padding="22,0" Margin="0,0,10,0" Command="{Binding ChatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChat}" FontSize="16" />
                                <TextBlock Text="聊一聊" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryButton}" Height="52" Command="{Binding BuyCommand}" IsEnabled="{Binding IsOnSale}">
                            <TextBlock Text="立即购买" FontSize="16" FontWeight="Bold" />
                        </Button>
                    </DockPanel>
                </StackPanel>

                <!-- 自己的商品：审核中 / 被驳回的说明 -->
                <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="16" Padding="18,14" Margin="0,22,0,0"
                        Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource LinkButton}" Content="刷新" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
                        <TextBlock TextWrapping="Wrap" FontSize="13.5" VerticalAlignment="Center"
                                   Text="AI 正在审核这件商品，通常几秒钟就好，通过后会自动上架并通知你。" />
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="16" Padding="18,14" Margin="0,22,0,0"
                        Visibility="{Binding IsRejected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="这件商品没有通过审核，已下架" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Text="{Binding Detail.RejectReason}" FontSize="13.5" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,6,0,0">
                            可以修改后重新提交审核，觉得判错了也可以<Hyperlink Command="{Binding AppealCommand}">申诉</Hyperlink>。
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 自己的商品：编辑 / 下架 / 重新上架 -->
                <StackPanel Orientation="Horizontal" Margin="0,22,0,0" Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}">
                    <Button Style="{StaticResource SecondaryButton}" Height="50" Padding="26,0" Margin="0,0,10,0" Command="{Binding EditCommand}" Visibility="{Binding IsSold, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconEdit}" FontSize="15" />
                            <TextBlock Text="编辑" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerButton}" Height="50" Padding="26,0" Content="下架" Command="{Binding OffShelfCommand}" Visibility="{Binding IsOnSale, Converter={StaticResource BoolToVis}}" />
                    <Button Style="{StaticResource PrimaryButton}" Height="50" Padding="26,0" Content="重新上架" Command="{Binding OnShelfCommand}" Visibility="{Binding IsOffShelf, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
