<!-- 首页：搜索条 + 分类/排序标签 + 商品网格。滚到底自动加载。 -->
<UserControl x:Class="XiaoYu.App.Pages.Trade.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services">
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" ScrollChanged="OnScroll">
        <Grid MaxWidth="1180" Margin="32,24,32,40" HorizontalAlignment="Stretch">
            <StackPanel>
                <!-- 搜索条 -->
                <Border Style="{StaticResource Field}" CornerRadius="26" MinHeight="52" Background="White" BorderBrush="{StaticResource LineBrush}" Padding="20,0,6,0">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButtonYellow}" Width="42" Height="42" Command="{Binding SearchCommand}" ToolTip="搜索">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="16" Foreground="{StaticResource TextBrush}" />
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="0,0,6,0" Command="{Binding ClearSearchCommand}"
                                Visibility="{Binding Keyword, Converter={StaticResource NotEmptyToVis}}">
                            <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconClose}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconSearch}" FontSize="16" Foreground="{StaticResource TertiaryTextBrush}" Margin="0,0,12,0" />
                        <TextBox Style="{StaticResource BareInput}" Tag="搜索闲置" FontSize="15" Text="{Binding Keyword, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}" /></TextBox.InputBindings>
                        </TextBox>
                    </DockPanel>
                </Border>

                <!-- 分类标签 -->
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,20,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource PillTab}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 排序 -->
                <DockPanel Margin="0,2,0,16">
                    <ItemsControl ItemsSource="{Binding Sorts}" DockPanel.Dock="Right">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <RadioButton Style="{StaticResource TabLine}" FontSize="13" Margin="18,0,0,0" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                             Command="{Binding DataContext.SelectSortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                             CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" VerticalAlignment="Center" />
                </DockPanel>

                <!-- 骨架屏（第一次加载时） -->
                <ItemsControl ItemsSource="{Binding SkeletonSlots}" Visibility="{Binding ShowSkeleton, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="216" Margin="0,0,16,18" Background="White" CornerRadius="18" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="0,0,0,14">
                                <StackPanel>
                                    <Border Style="{StaticResource Skeleton}" Height="212" CornerRadius="17,17,0,0" />
                                    <Border Style="{StaticResource Skeleton}" Height="14" Margin="14,14,50,0" />
                                    <Border Style="{StaticResource Skeleton}" Height="20" Width="80" HorizontalAlignment="Left" Margin="14,10,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 商品网格 -->
                <ItemsControl ItemsSource="{Binding Goods}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate><c:GoodsCard /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:EmptyState Glyph="{StaticResource IconSearch}" Text="没有找到相关闲置" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />

                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Padding="26,10"
                        Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="加载更多" VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconChevronDown}" FontSize="11" Margin="8,2,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
