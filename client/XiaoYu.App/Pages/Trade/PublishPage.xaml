<!-- 发布/编辑：图片方块 → 标题 → 价格 → 描述 → 分类标签 → 成色标签 → 提交。几乎没有说明文字。 -->
<UserControl x:Class="XiaoYu.App.Pages.Trade.PublishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="28" Padding="34,30,34,34" MaxWidth="780" Margin="32,26,32,40" VerticalAlignment="Top"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="1" s:Motion.Appear="True">
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource H1}" />

                <!-- 图片：已上传的缩略图 + 末尾一个"添加"方块，同一排 -->
                <ItemsControl ItemsSource="{Binding Images}" Margin="0,22,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Width="104" Height="104" Margin="0,0,12,12">
                                <!-- 一张图片 -->
                                <Grid Visibility="{Binding IsAdd, Converter={StaticResource InvBoolToVis}}">
                                    <Border CornerRadius="18" Background="#F0F0EC">
                                        <Grid>
                                            <Grid.Clip><RectangleGeometry Rect="0,0,104,104" RadiusX="18" RadiusY="18" /></Grid.Clip>
                                            <Image s:RemoteImage.Source="{Binding Name}" Stretch="UniformToFill" />
                                        </Grid>
                                    </Border>
                                    <Border Background="#B3000000" CornerRadius="8" Padding="7,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="7"
                                            Visibility="{Binding IsCover, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="封面" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                    </Border>
                                    <Button Style="{StaticResource IconButton}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,5,0" Background="#B3000000"
                                            Command="{Binding DataContext.RemoveImageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconClose}" FontSize="9" Foreground="White" />
                                    </Button>
                                </Grid>
                                <!-- 添加方块 -->
                                <Button Padding="0" Cursor="Hand" Visibility="{Binding IsAdd, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.AddImagesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid Background="Transparent">
                                                <Rectangle x:Name="Dash" RadiusX="18" RadiusY="18" Stroke="#CFCFC9" StrokeThickness="2" StrokeDashArray="4 3" Fill="#FAFAF8" />
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="Ico" Style="{StaticResource Icon}" Text="{StaticResource IconCamera}" FontSize="26" Foreground="{StaticResource SecondaryTextBrush}" />
                                                    <TextBlock Style="{StaticResource Hint}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                                        <Run Text="{Binding DataContext.RealCount, Mode=OneWay, RelativeSource={RelativeSource AncestorType=ItemsControl}}" /><Run Text="/9" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Dash" Property="Stroke" Value="{StaticResource PrimaryDark}" />
                                                    <Setter TargetName="Dash" Property="Fill" Value="{StaticResource PrimarySoft}" />
                                                    <Setter TargetName="Ico" Property="Foreground" Value="#C99A00" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Hint}" Text="正在上传…" Margin="2,10,0,0" Visibility="{Binding IsUploading, Converter={StaticResource BoolToVis}}" />

                <!-- 标题 -->
                <Border Style="{StaticResource Field}" Margin="0,22,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconTag}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                        <TextBox Style="{StaticResource BareInput}" Tag="标题" MaxLength="30" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontSize="15" />
                    </DockPanel>
                </Border>

                <!-- 价格 -->
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="¥" FontWeight="Bold" FontSize="17" Foreground="{StaticResource PriceBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Style="{StaticResource BareInput}" Tag="价格" Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" FontWeight="SemiBold" />
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource Field}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="¥" FontSize="15" Foreground="{StaticResource TertiaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBox Style="{StaticResource BareInput}" Tag="原价（选填）" Text="{Binding OriginalPriceText, UpdateSourceTrigger=PropertyChanged}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <!-- 描述 -->
                <Border Style="{StaticResource Field}" Margin="0,12,0,0" Padding="14,10" MinHeight="120">
                    <TextBox Style="{StaticResource BareInput}" Tag="描述一下它的故事、成色、交易方式…" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                             MaxLength="500" Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" MinHeight="96" />
                </Border>

                <!-- 分类 -->
                <ItemsControl ItemsSource="{Binding Categories}" Margin="0,20,0,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource PillTab}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.SelectCategoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 成色 -->
                <WrapPanel Margin="0,4,0,0">
                    <RadioButton Style="{StaticResource PillTab}" Content="全新" IsChecked="{Binding ConditionKey, Converter={StaticResource ValueEquals}, ConverterParameter=0, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource PillTab}" Content="几乎全新" IsChecked="{Binding ConditionKey, Converter={StaticResource ValueEquals}, ConverterParameter=1, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource PillTab}" Content="轻微使用痕迹" IsChecked="{Binding ConditionKey, Converter={StaticResource ValueEquals}, ConverterParameter=2, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource PillTab}" Content="明显使用痕迹" IsChecked="{Binding ConditionKey, Converter={StaticResource ValueEquals}, ConverterParameter=3, Mode=TwoWay}" />
                </WrapPanel>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,10,0,0" />

                <Button Style="{StaticResource PrimaryButton}" Height="52" Margin="0,18,0,0" Command="{Binding SubmitCommand}">
                    <TextBlock Text="{Binding SubmitText}" FontSize="16" FontWeight="Bold" />
                </Button>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
