<!-- 注册窗口：和登录同一套风格。密码框下面是强度条和四个规则小标签（满足一条亮一条）。 -->
<Window x:Class="XiaoYu.App.Pages.Trade.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:XiaoYu.App.Services"
        Icon="pack://application:,,,/XiaoYu;component/app.ico"
        Title="注册" Width="440" Height="860"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Microsoft YaHei UI" FontSize="14"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <!-- 规则小标签：Tag 绑 true/false，满足时变绿 -->
        <Style x:Key="RuleChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{StaticResource FieldBrush}" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource TertiaryTextBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid ClipToBounds="True">
        <Ellipse Width="300" Height="300" Fill="{StaticResource Primary}" Opacity="0.95" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-170,-130,0" />

        <StackPanel VerticalAlignment="Center" Margin="48,10,48,10" s:Motion.Appear="True">
            <Border Width="64" Height="64" CornerRadius="22" Background="{StaticResource Primary}" HorizontalAlignment="Center" BorderBrush="White" BorderThickness="2.5">
                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconAdd}" FontSize="26" Foreground="{StaticResource TextBrush}" />
            </Border>
            <TextBlock Text="创建账号" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,16,0,26" />

            <Border Style="{StaticResource Field}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconUser}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource BareInput}" Tag="用户名（3–20 位字母数字）" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconTag}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBox Style="{StaticResource BareInput}" Tag="昵称" Text="{Binding Nickname, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconMail}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBox x:Name="EmailBox" Style="{StaticResource BareInput}" Tag="邮箱（用来收验证码，也能用来登录）" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" MaxLength="64" />
                </DockPanel>
            </Border>
            <DockPanel Margin="0,12,0,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Height="50" MinWidth="118" Margin="10,0,0,0" Padding="14,0"
                        Content="{Binding CodeButtonText}" Command="{Binding SendCodeCommand}" IsEnabled="{Binding CanSendCode}" />
                <Border Style="{StaticResource Field}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                        <TextBox Style="{StaticResource BareInput}" Tag="6 位验证码" Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" />
                    </DockPanel>
                </Border>
            </DockPanel>
            <TextBlock Text="{Binding CodeHint}" Style="{StaticResource Hint}" Foreground="{StaticResource SuccessBrush}" TextWrapping="Wrap" Margin="4,8,0,0"
                       Visibility="{Binding CodeHint, Converter={StaticResource NotEmptyToVis}}" />
            <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource BarePassword}" PasswordChanged="OnPasswordChanged" MaxLength="32" />
                </DockPanel>
            </Border>

            <!-- 强度条 -->
            <Grid Margin="2,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition /><ColumnDefinition /><ColumnDefinition /><ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding Segment1}" />
                <Border Grid.Column="1" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding Segment2}" />
                <Border Grid.Column="2" Height="4" CornerRadius="2" Margin="0,0,5,0" Background="{Binding Segment3}" />
                <Border Grid.Column="3" Height="4" CornerRadius="2" Background="{Binding Segment4}" />
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <Border Style="{StaticResource RuleChip}" Tag="{Binding HasLength}"><TextBlock FontSize="12" Text="8 位+" /></Border>
                <Border Style="{StaticResource RuleChip}" Tag="{Binding HasDigit}"><TextBlock FontSize="12" Text="123" /></Border>
                <Border Style="{StaticResource RuleChip}" Tag="{Binding HasUpper}"><TextBlock FontSize="12" Text="ABC" /></Border>
                <Border Style="{StaticResource RuleChip}" Tag="{Binding HasLower}"><TextBlock FontSize="12" Text="abc" /></Border>
            </StackPanel>

            <Border Style="{StaticResource Field}" Margin="0,14,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Icon}" Text="{StaticResource IconCheck}" FontSize="15" Foreground="{StaticResource SuccessBrush}"
                               Visibility="{Binding PasswordsMatch, Converter={StaticResource BoolToVis}}" />
                    <PasswordBox x:Name="ConfirmBox" Style="{StaticResource BarePassword}" PasswordChanged="OnConfirmChanged" MaxLength="32" />
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,12,0,0" />

            <Button Style="{StaticResource PrimaryButton}" Height="50" Margin="0,20,0,0" IsDefault="True" Command="{Binding RegisterCommand}">
                <TextBlock Text="注册" FontSize="16" FontWeight="Bold" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
