<!-- 订单列表：状态标签 + 一行一单（封面、标题、对方、价格、彩色状态） -->
<UserControl x:Class="XiaoYu.App.Pages.Me.OrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="840" Margin="32,26,32,40" HorizontalAlignment="Stretch">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="2,0,0,18">
                    <Border Width="44" Height="44" CornerRadius="16" Background="{StaticResource Primary}">
                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" FontSize="20" Foreground="{StaticResource TextBrush}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource H1}" Margin="14,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Filters}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Style="{StaticResource PillTab}" Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                         Command="{Binding DataContext.SelectFilterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,0,0,8" />

                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource RowButton}" Margin="0,0,0,12" s:Motion.Appear="True"
                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                <Border Background="White" CornerRadius="22" Padding="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="84" Height="84" Background="#F0F0EC" Margin="0,0,16,0">
                                            <Grid.Clip><RectangleGeometry Rect="0,0,84,84" RadiusX="18" RadiusY="18" /></Grid.Clip>
                                            <Image s:RemoteImage.Source="{Binding Order.GoodsCover}" Stretch="UniformToFill" />
                                        </Grid>
                                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Stretch" HorizontalAlignment="Right" Margin="14,0,0,0">
                                            <Border CornerRadius="12" Padding="12,4" HorizontalAlignment="Right"
                                                    Background="{Binding Order.Status, Converter={StaticResource OrderStatusSoftBrush}}">
                                                <TextBlock Text="{Binding Order.Status, Converter={StaticResource OrderStatusText}}" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{Binding Order.Status, Converter={StaticResource OrderStatusBrush}}" />
                                            </Border>
                                            <TextBlock HorizontalAlignment="Right" Margin="0,14,0,0" Foreground="{StaticResource TextBrush}" FontWeight="Bold">
                                                <Run Text="¥" FontSize="12" /><Run Text="{Binding Order.Price, Mode=OneWay, Converter={StaticResource Yuan}}" FontSize="18" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Order.GoodsTitle}" FontSize="15.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <c:Avatar Image="{Binding Other.Avatar}" Nickname="{Binding Other.Nickname}" Size="22" />
                                                <TextBlock Text="{Binding Other.Nickname}" Style="{StaticResource Hint}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconClock}" FontSize="11" Foreground="{StaticResource TertiaryTextBrush}" />
                                                <TextBlock Text="{Binding Order.CreatedAt, Converter={StaticResource TimeAgo}}" Style="{StaticResource Hint}" Foreground="{StaticResource TertiaryTextBrush}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <c:EmptyState Glyph="{StaticResource IconPackage}" Text="这里还没有订单" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                <Button Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,6,0,0" Padding="26,10" Command="{Binding LoadMoreCommand}"
                        Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" Content="加载更多" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
