<!-- 修改密码：原密码 + 新密码 + 再输一次。圆角白卡片对话框。 -->
<Window x:Class="XiaoYu.App.Pages.Me.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        SizeToContent="WidthAndHeight" ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" FontFamily="Microsoft YaHei UI" FontSize="14">
    <Grid Margin="28">
        <Border x:Name="Card" Background="White" CornerRadius="22" Padding="30,26,30,24" Width="420">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Opacity="0.18" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="修改密码" Style="{StaticResource H2}" />
                <TextBlock Text="改完以后，其他设备上的登录会失效" Style="{StaticResource Hint}" Margin="0,6,0,16" />
                <Border Style="{StaticResource Field}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="原密码" Width="64" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <PasswordBox x:Name="OldBox" Style="{StaticResource BarePassword}" MaxLength="32" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="新密码" Width="64" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <PasswordBox x:Name="NewBox" Style="{StaticResource BarePassword}" MaxLength="32" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Field}" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="再输一次" Width="64" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}" />
                        <PasswordBox x:Name="ConfirmBox" Style="{StaticResource BarePassword}" MaxLength="32" />
                    </DockPanel>
                </Border>
                <TextBlock Text="8–32 位，同时包含数字、大写字母和小写字母" Style="{StaticResource Hint}" Margin="4,8,0,0" />
                <TextBlock x:Name="ErrorLine" Style="{StaticResource ErrorText}" Margin="4,8,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="取消" MinWidth="100" Margin="0,0,12,0" IsCancel="True" Click="OnCancel" />
                    <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="确定修改" MinWidth="110" IsDefault="True" Click="OnOk" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
