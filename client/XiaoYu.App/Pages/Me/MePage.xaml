<!-- 我的：资料卡 / 余额卡 + 订单入口 / 我发布的、我的收藏 -->
<UserControl x:Class="XiaoYu.App.Pages.Me.MePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:XiaoYu.App.Controls"
             xmlns:s="clr-namespace:XiaoYu.App.Services">
    <UserControl.Resources>
        <!-- 订单入口方块：图标 + 文字，有待处理时右上角红点 -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="White" CornerRadius="24" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="Sc" /></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource PrimarySoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.07" />
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.07" />
                                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                    <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                                </Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 充值小标签 -->
        <Style x:Key="AmountChip" TargetType="Button" BasedOn="{StaticResource BaseButton}">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Padding" Value="16,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid MaxWidth="980" Margin="32,26,32,40" HorizontalAlignment="Stretch">
            <StackPanel>
                <!-- 资料卡 -->
                <Border Background="White" CornerRadius="28" Padding="30,26" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" s:Motion.Appear="True">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource IconButton}" Command="{Binding StartEditCommand}" ToolTip="编辑资料" Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconEdit}" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding ChangePasswordCommand}" ToolTip="修改密码">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconLock}" FontSize="16" />
                            </Button>
                            <Button Style="{StaticResource IconButton}" Command="{Binding LogoutCommand}" ToolTip="退出登录">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconPower}" FontSize="16" Foreground="{StaticResource DangerBrush}" />
                            </Button>
                        </StackPanel>
                        <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="92" Height="92" Margin="0,0,24,0" VerticalAlignment="Top" Command="{Binding ChangeAvatarCommand}" ToolTip="换头像">
                            <c:Avatar Image="{Binding Me.Avatar}" Nickname="{Binding Me.Nickname}" Size="88" />
                        </Button>
                        <!-- 查看 -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding Me.Nickname}" Style="{StaticResource H1}" FontSize="26" />
                            <TextBlock Text="{Binding Me.Bio}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Me.Bio, Converter={StaticResource NotEmptyToVis}}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{Binding Me.Username}" />
                        </StackPanel>
                        <!-- 编辑 -->
                        <StackPanel VerticalAlignment="Center" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Field}" MinHeight="42">
                                <TextBox Style="{StaticResource BareInput}" Tag="昵称" MaxLength="20" Text="{Binding EditNickname, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                            <Border Style="{StaticResource Field}" MinHeight="42" Margin="0,8,0,0">
                                <TextBox Style="{StaticResource BareInput}" Tag="一句话介绍自己" MaxLength="100" Text="{Binding EditBio, UpdateSourceTrigger=PropertyChanged}" />
                            </Border>
                            <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="4,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Content="保存" Padding="26,8" Margin="0,0,10,0" Command="{Binding SaveProfileCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="取消" Padding="26,8" Command="{Binding CancelEditCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 余额 + 订单入口 -->
                <Grid Margin="0,16,0,0" s:Motion.Appear="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{StaticResource Primary}" CornerRadius="24" Padding="26,22" MinHeight="132">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Width="40" Height="40" Background="#40FFFFFF" Command="{Binding ToggleRechargeCommand}" ToolTip="充值">
                                    <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconAdd}" FontSize="16" />
                                </Button>
                                <TextBlock Foreground="{StaticResource TextBrush}" FontWeight="Bold" VerticalAlignment="Center">
                                    <Run Text="¥" FontSize="22" /><Run Text="{Binding Me.Balance, Mode=OneWay, Converter={StaticResource Yuan}}" FontSize="40" />
                                </TextBlock>
                            </DockPanel>
                            <WrapPanel Margin="0,16,0,0" Visibility="{Binding IsRecharging, Converter={StaticResource BoolToVis}}">
                                <Button Style="{StaticResource AmountChip}" Content="+50" Command="{Binding RechargeCommand}" CommandParameter="5000" />
                                <Button Style="{StaticResource AmountChip}" Content="+100" Command="{Binding RechargeCommand}" CommandParameter="10000" />
                                <Button Style="{StaticResource AmountChip}" Content="+500" Command="{Binding RechargeCommand}" CommandParameter="50000" />
                                <Button Style="{StaticResource AmountChip}" Content="+1000" Command="{Binding RechargeCommand}" CommandParameter="100000" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Button Grid.Column="2" Style="{StaticResource TileButton}" Command="{Binding OpenBuyingCommand}" MinHeight="132">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconPackage}" FontSize="30" />
                                <TextBlock Text="买到的" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-30,0"
                                    Visibility="{Binding BuyerPending, Converter={StaticResource NotEmptyToVis}}" ToolTip="待收货">
                                <TextBlock Text="{Binding BuyerPending}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                    <Button Grid.Column="4" Style="{StaticResource TileButton}" Command="{Binding OpenSellingCommand}" MinHeight="132">
                        <Grid>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconTag}" FontSize="30" />
                                <TextBlock Text="卖出的" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{StaticResource DangerBrush}" CornerRadius="10" MinWidth="20" Height="20" Padding="6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-24,-30,0"
                                    Visibility="{Binding SellerPending, Converter={StaticResource NotEmptyToVis}}" ToolTip="待发货">
                                <TextBlock Text="{Binding SellerPending}" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Button>
                </Grid>

                <!-- 标签页 -->
                <StackPanel Orientation="Horizontal" Margin="6,30,0,16">
                    <RadioButton Style="{StaticResource TabLine}" Content="我发布的" IsChecked="{Binding Tab, Converter={StaticResource ValueEquals}, ConverterParameter=mine, Mode=TwoWay}" />
                    <RadioButton Style="{StaticResource TabLine}" Content="我的收藏" IsChecked="{Binding Tab, Converter={StaticResource ValueEquals}, ConverterParameter=fav, Mode=TwoWay}" />
                </StackPanel>

                <TextBlock Style="{StaticResource ErrorText}" Text="{Binding ErrorMessage}" Margin="8,0,0,12" Visibility="{Binding IsEditing, Converter={StaticResource InvBoolToVis}}" />
                <StackPanel Visibility="{Binding ShowMine, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding MyGoods}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><c:GoodsCard /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:EmptyState Glyph="{StaticResource IconCamera}" Text="还没发布过闲置" Visibility="{Binding MineEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Visibility="{Binding ShowFavorites, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Favorites}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><c:CardGrid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate><DataTemplate><c:GoodsCard /></DataTemplate></ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <c:EmptyState Glyph="{StaticResource IconHeartOutline}" Text="还没有收藏" Visibility="{Binding FavoritesEmpty, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
