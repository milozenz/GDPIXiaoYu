                <GeometryDrawing Brush="#FFD21F" Geometry="M7,33 L29,33 L29,50.5 Z"><GeometryDrawing.Pen><Pen Brush="#FFD21F" Thickness="0.6" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FFC21A" Geometry="M29,12.5 L44.5,32 L29,33 Z"><GeometryDrawing.Pen><Pen Brush="#FFC21A" Thickness="0.6" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FFA800" Geometry="M29,33 L44.5,32 L29,50.5 Z"><GeometryDrawing.Pen><Pen Brush="#FFA800" Thickness="0.6" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FF8A1F" Geometry="M44.5,32 L58,17 L52.5,32 Z"><GeometryDrawing.Pen><Pen Brush="#FF8A1F" Thickness="0.6" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
                <GeometryDrawing Brush="#FF6A14" Geometry="M44.5,32 L52.5,32 L58,47 Z"><GeometryDrawing.Pen><Pen Brush="#FF6A14" Thickness="0.6" LineJoin="Round" /></GeometryDrawing.Pen></GeometryDrawing>
