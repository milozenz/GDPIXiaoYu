<!--
  全局主题：闲鱼黄 + 极简。颜色、文字、图标、按钮、标签、输入框、滚动条、动画都在这里。
  设计原则：
    1. 少文字，多图标（图标字体 Segoe MDL2 Assets，下面的 Icon* 常量）
    2. 圆角大、留白足，只有一个主色（黄），价格用橙红
    3. 点击、悬停、切换都有短而轻的动画（0.1–0.25 秒），不抢戏
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:cv="clr-namespace:XiaoYu.App.Converters"
                    xmlns:s="clr-namespace:XiaoYu.App.Services">

    <!-- ==================== 颜色 ==================== -->
    <Color x:Key="PrimaryColor">#FFE033</Color>
    <SolidColorBrush x:Key="Primary" Color="#FFE033" />
    <SolidColorBrush x:Key="PrimaryDark" Color="#F5C400" />
    <SolidColorBrush x:Key="PrimaryLight" Color="#FFF3A8" />
    <SolidColorBrush x:Key="PrimarySoft" Color="#FFFBE0" />
    <SolidColorBrush x:Key="PriceBrush" Color="#FF5000" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F1F1F" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8A8A8A" />
    <SolidColorBrush x:Key="TertiaryTextBrush" Color="#BDBDBD" />
    <SolidColorBrush x:Key="BackgroundBrush" Color="#F6F6F4" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="FieldBrush" Color="#F3F3F1" />
    <SolidColorBrush x:Key="LineBrush" Color="#EDEDEB" />
    <SolidColorBrush x:Key="DangerBrush" Color="#F5484A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFECEC" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#1FB26B" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E5F7EE" />
    <SolidColorBrush x:Key="LinkBrush" Color="#1677FF" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="#E8F1FF" />

    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

    <!-- ==================== 图标（Segoe MDL2 Assets 字形） ==================== -->
    <sys:String x:Key="IconHome">&#xE80F;</sys:String>
    <sys:String x:Key="IconSearch">&#xE721;</sys:String>
    <sys:String x:Key="IconAdd">&#xE710;</sys:String>
    <sys:String x:Key="IconChat">&#xE8BD;</sys:String>
    <sys:String x:Key="IconUser">&#xE77B;</sys:String>
    <sys:String x:Key="IconBack">&#xE72B;</sys:String>
    <sys:String x:Key="IconClose">&#xE711;</sys:String>
    <sys:String x:Key="IconHeart">&#xEB52;</sys:String>
    <sys:String x:Key="IconHeartOutline">&#xEB51;</sys:String>
    <sys:String x:Key="IconSend">&#xE724;</sys:String>
    <sys:String x:Key="IconEdit">&#xE70F;</sys:String>
    <sys:String x:Key="IconDelete">&#xE74D;</sys:String>
    <sys:String x:Key="IconCheck">&#xE73E;</sys:String>
    <sys:String x:Key="IconCamera">&#xE722;</sys:String>
    <sys:String x:Key="IconPhoto">&#xE91B;</sys:String>
    <sys:String x:Key="IconEye">&#xE7B3;</sys:String>
    <sys:String x:Key="IconEyeOff">&#xED1A;</sys:String>
    <sys:String x:Key="IconClock">&#xE121;</sys:String>
    <sys:String x:Key="IconPower">&#xE7E8;</sys:String>
    <sys:String x:Key="IconChevronRight">&#xE76C;</sys:String>
    <sys:String x:Key="IconChevronLeft">&#xE76B;</sys:String>
    <sys:String x:Key="IconChevronDown">&#xE70D;</sys:String>
    <sys:String x:Key="IconChevronUp">&#xE70E;</sys:String>
    <sys:String x:Key="IconShop">&#xE719;</sys:String>
    <sys:String x:Key="IconPackage">&#xE7B8;</sys:String>
    <sys:String x:Key="IconMail">&#xE715;</sys:String>
    <sys:String x:Key="IconLock">&#xE72E;</sys:String>
    <sys:String x:Key="IconTag">&#xE1CB;</sys:String>
    <sys:String x:Key="IconMore">&#xE712;</sys:String>
    <sys:String x:Key="IconRefresh">&#xE72C;</sys:String>
    <sys:String x:Key="IconFilter">&#xE71C;</sys:String>
    <sys:String x:Key="IconShoppingCart">&#xE7BF;</sys:String>
    <sys:String x:Key="IconPhone">&#xE717;</sys:String>
    <sys:String x:Key="IconUp">&#xE74A;</sys:String>

    <!-- ==================== 转换器 ==================== -->
    <cv:MoneyConverter x:Key="Money" />                       <!-- 32000 → ¥320 -->
    <cv:YuanConverter x:Key="Yuan" />                         <!-- 32000 → 320（不带 ¥，价格大字 + 小 ¥ 用） -->
    <cv:TimeAgoConverter x:Key="TimeAgo" />
    <cv:DateTimeConverter x:Key="DateTime" />
    <cv:GoodsStatusTextConverter x:Key="GoodsStatusText" />
    <cv:OrderStatusTextConverter x:Key="OrderStatusText" />
    <cv:OrderStatusBrushConverter x:Key="OrderStatusBrush" />   <!-- 订单状态 → 文字颜色 -->
    <cv:OrderStatusSoftBrushConverter x:Key="OrderStatusSoftBrush" />  <!-- 订单状态 → 底色 -->
    <cv:ConditionTextConverter x:Key="ConditionText" />
    <cv:BoolToVisibilityConverter x:Key="BoolToVis" />
    <cv:BoolToVisibilityConverter x:Key="InvBoolToVis" Invert="True" />
    <cv:InverseBoolConverter x:Key="InvBool" />
    <cv:NotEmptyToVisibilityConverter x:Key="NotEmptyToVis" />
    <cv:NotEmptyToVisibilityConverter x:Key="EmptyToVis" Invert="True" />
    <cv:ValueEqualsConverter x:Key="ValueEquals" />

    <!-- ==================== 文字 ==================== -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    </Style>
    <Style x:Key="Body" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
    </Style>
    <Style x:Key="PriceText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource PriceBrush}" />
    </Style>
    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 图标：<TextBlock Style="{StaticResource Icon}" Text="{StaticResource IconHome}" FontSize="20" /> -->
    <Style x:Key="Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!-- ==================== 卡片 ==================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- 输入框外壳：聚焦时边框变黄。里面放图标 + BareInput -->
    <Style x:Key="Field" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="MinHeight" Value="46" />
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 小标签（只读）：分类名、成色 -->
    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- 骨架屏：加载时的灰块，呼吸闪烁 -->
    <Style x:Key="Skeleton" TargetType="Border">
        <Setter Property="Background" Value="#ECECE8" />
        <Setter Property="CornerRadius" Value="10" />
        <Style.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.8" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== 按钮 ==================== -->
    <!-- 所有按钮：悬停轻微放大，按下缩小，禁用变淡 -->
    <Style x:Key="BaseButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="22,10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="22" Padding="{TemplateBinding Padding}">
                        <Border.RenderTransform><ScaleTransform x:Name="Sc" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1.03" Duration="0:0:0.12" />
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1.03" Duration="0:0:0.12" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.95" Duration="0:0:0.07" />
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.95" Duration="0:0:0.07" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 主按钮：黄色。一个界面里最重要的那一个 -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- 次要按钮：浅灰底 -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
    </Style>
    <!-- 危险操作：浅红底红字 -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="LinkButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <!-- 整行可点（订单行、会话行）：透明、内容撑满，不放大 -->
    <Style x:Key="RowButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FAFAF8" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#F3F3F1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 圆形图标按钮：Content 放一个 Icon -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" RenderTransformOrigin="0.5,0.5" Background="{TemplateBinding Background}" CornerRadius="20">
                        <Border.RenderTransform><ScaleTransform x:Name="Sc" /></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EFEFEC" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.88" Duration="0:0:0.07" />
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.88" Duration="0:0:0.07" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.15" />
                                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.15" />
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="IconButtonYellow" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Background" Value="{StaticResource Primary}" />
    </Style>

    <!-- ==================== 单选标签 ==================== -->
    <!-- 顶部导航：只有图标；选中时变成黄色药丸并显示文字（文字放在 Tag 里） -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="3,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Height="40" MinWidth="40" CornerRadius="20" Padding="12,0">
                        <Border.Background><SolidColorBrush x:Name="Bg" Color="Transparent" /></Border.Background>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Cp" VerticalAlignment="Center" TextElement.Foreground="{StaticResource SecondaryTextBrush}" />
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" FontWeight="SemiBold" FontSize="14" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource TextBrush}" Visibility="Collapsed" Opacity="0" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#EFEFEC" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary}" />
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource TextBrush}" />
                            <Setter TargetName="Label" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="Label" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22" />
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 页面里的小标签（分类、排序、订单状态） -->
    <Style x:Key="PillTab" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="17" Padding="15,7" Background="White" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Primary}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 选项卡（下划线式）：我的页、订单页顶部 -->
    <Style x:Key="TabLine" TargetType="RadioButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="0,0,26,0" />
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <StackPanel Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" Margin="0,4,0,8" />
                        <Border x:Name="Line" Height="3" CornerRadius="2" Background="Transparent" Width="22" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{StaticResource Primary}" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 输入框 ==================== -->
    <!-- 无边框输入框，放进 Field 外壳里用；Tag 写灰色提示 -->
    <Style x:Key="BareInput" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                        <TextBlock x:Name="HintText" Foreground="#B5B5B2" IsHitTestVisible="False" Visibility="Collapsed"
                                   VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="2,0,0,0" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 密码框：右边带一个小眼睛，按下去显示明文，再按一次隐藏（逻辑在 Services/PasswordReveal.cs） -->
    <Style x:Key="BarePassword" TargetType="PasswordBox">
        <!-- PasswordBox 不会继承窗口字体（默认是 Times New Roman），显示明文时会很显眼，所以写死 -->
        <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="s:PasswordReveal.Enabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <DockPanel Background="Transparent">
                        <ToggleButton x:Name="PART_Eye" DockPanel.Dock="Right" Focusable="False" Cursor="Hand" ToolTip="显示密码"
                                      Width="28" Height="28" Margin="8,-6,-6,-6" VerticalAlignment="Center">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="14">
                                        <TextBlock x:Name="Glyph" Style="{StaticResource Icon}" Text="{StaticResource IconEye}" FontSize="15"
                                                   Foreground="{StaticResource TertiaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Glyph" Property="Text" Value="{StaticResource IconEyeOff}" />
                                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource TextBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                            <!-- 显示明文时用的输入框，和上面的密码内容保持同步 -->
                            <TextBox x:Name="PART_Plain" Visibility="Collapsed" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" Background="Transparent"
                                     Foreground="{TemplateBinding Foreground}" CaretBrush="{TemplateBinding CaretBrush}" BorderThickness="0" VerticalAlignment="Center">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 带外壳的输入框（单个控件，不需要图标时用）：<TextBox Style="{StaticResource Input}" Tag="提示" /> -->
    <Style x:Key="Input" TargetType="TextBox">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="Background" Value="{StaticResource FieldBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="14" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Focusable="False" />
                            <TextBlock x:Name="HintText" Foreground="#B5B5B2" IsHitTestVisible="False" Visibility="Collapsed"
                                       Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                       Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource PrimaryDark}" />
                            <Setter TargetName="Bd" Property="Background" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== 滚动条：细、圆、悬停变深 ==================== -->
    <Style x:Key="ThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="T" CornerRadius="3" Background="#D6D6D2" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="T" Property="Background" Value="#B5B5B0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <ControlTemplate x:Key="VScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="1,0" /></Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="HScrollBarTemplate" TargetType="ScrollBar">
        <Grid Background="Transparent">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" /></Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" /></Track.IncreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ThumbStyle}" Margin="0,1" /></Track.Thumb>
            </Track>
        </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="8" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="Template" Value="{StaticResource VScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="8" />
                <Setter Property="Template" Value="{StaticResource HScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 悬停提示：深色小气泡 -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#EE2A2A2A" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 页面还没做好时的占位框（现在不再用，留着兼容） -->
    <Style x:Key="Placeholder" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Margin" Value="40" />
        <Setter Property="Padding" Value="40" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- 标志：折纸鱼，和 assets/logo.svg 一样（64x64 的画布，透明矩形固定住画布大小）。用法：<Image Source="{StaticResource LogoImage}" Width="40" Height="40" /> -->
    <DrawingImage x:Key="LogoImage">
